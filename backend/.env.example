# Required in production
DATABASE_URL=postgresql://user:password@localhost:5432/mytube
NODE_ENV=development
SESSION_SECRET=replace-with-32-plus-char-random-secret
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=MyTube
WEBAUTHN_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Optional
PORT=4000
GNEWS_API_KEY=
PIPED_INSTANCES=https://pipedapi.kavin.rocks
CACHE_VIDEO_TTL=600
CACHE_CHANNEL_TTL=600
CACHE_TRENDING_TTL=300
CACHE_SEARCH_TTL=300
RATE_LIMIT_MAX=100
DB_POOL_SIZE=10
